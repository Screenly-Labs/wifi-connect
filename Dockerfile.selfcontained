# A single-architecture `docker build .` for developers.
#
# This is NOT the release path — see Dockerfile, which assembles the
# multi-arch image from binaries cross-compiled by CI. This one exists so a
# contributor can build and run the container without CI, on their own
# architecture only.

# Pinned by the multi-arch index digest, so every architecture resolves to
# the image that was reviewed rather than to whatever the tag points at
# today. The tag is kept for readability; bump both together.
FROM rust:1.99-alpine@sha256:557a94c82b485a14b569120e00867267108c734efe33f10cc31ca0cd5dd1eca9 AS builder

# musl-dev provides the libc headers the linker wants and the headers ring
# (rustls's crypto, for error reporting) compiles its C against. The image
# already has gcc.
RUN apk add --no-cache musl-dev

WORKDIR /src
COPY . .

# ui/dist is committed, so no bun is needed here. That is the whole reason
# it is committed: `cargo build` must never require a JavaScript toolchain.
RUN cargo build --release --locked \
 && install -D target/release/wifi-connect /out/wifi-connect

FROM scratch
COPY --from=builder /out/wifi-connect /wifi-connect
ENV TZ=UTC
EXPOSE 80/tcp 53/udp 67/udp
ENTRYPOINT ["/wifi-connect"]
